        "import numpy as np\n",
        "import tensorflow as tf\n",
        "import matplotlib.pyplot as plt\n",
        "import os\n",
        "from tensorflow.keras import layers, models\n",
        "\n",
        "# --- 1. Programmatically Generate High-Frequency Bearing Vibrational Telemetry ---\n",
        "print(\"⚙️ Synthesizing high-frequency bearing vibrational data matrix...\")\n",
        "np.random.seed(42)\n",
        "num_samples_per_class = 400\n",
        "signal_length = 128  # High-frequency window length\n",
        "\n",
        "# Classes: 0: Normal, 1: Inner Race Fault, 2: Outer Race Fault, 3: Ball Element Fault\n",
        "X = []\n",
        "y = []\n",
        "\n",
        "for class_idx in range(4):\n",
        "    for _ in range(num_samples_per_class):\n",
        "        t = np.linspace(0, 1, signal_length)\n",
        "        if class_idx == 0:  # Normal / Healthy state\n",
        "            vibration = 0.2 * np.sin(2 * np.pi * 15 * t) + np.random.normal(0, 0.05, signal_length)\n",
        "        elif class_idx == 1:  # Inner Race Fault (High frequency impacts)\n",
        "            vibration = 0.6 * np.sin(2 * np.pi * 85 * t) * np.cos(2 * np.pi * 5 * t) + np.random.normal(0, 0.1, signal_length)\n",
        "        elif class_idx == 2:  # Outer Race Fault (Severe structural repetition)\n",
        "            vibration = 0.8 * np.sign(np.sin(2 * np.pi * 40 * t)) + np.random.normal(0, 0.15, signal_length)\n",
        "        elif class_idx == 3:  # Ball Fault (Irregular transient bursts)\n",
        "            vibration = 0.5 * np.sin(2 * np.pi * 120 * t) * np.exp(-5 * (t - 0.5)**2) + np.random.normal(0, 0.12, signal_length)\n",
        "\n",
        "        X.append(vibration)\n",
        "        y.append(class_idx)\n",
        "\n",
        "X = np.array(X)[..., np.newaxis].astype(np.float32)\n",
        "y = np.array(y)\n",
        "\n",
        "# Shuffle and partition into training and validation datasets\n",
        "indices = np.arange(len(X))\n",
        "np.random.shuffle(indices)\n",
        "X, y = X[indices], y[indices]\n",
        "\n",
        "split = int(0.8 * len(X))\n",
        "X_train, X_val = X[:split], X[split:]\n",
        "y_train, y_val = y[:split], y[split:]\n",
        "\n",
        "print(f\"📊 Dataset successfully prepared. Training: {X_train.shape[0]} samples | Validation: {X_val.shape[0]} samples\\n\")\n",
        "\n",
        "# --- 2. Design and Train Deep Edge AI Architecture ---\n",
        "model = models.Sequential([\n",
        "    layers.Input(shape=(signal_length, 1)),\n",
        "    layers.Conv1D(16, 3, activation='relu', padding='same'),\n",
        "    layers.MaxPooling1D(2),\n",
        "    layers.Flatten(),\n",
        "    layers.Dense(32, activation='relu'),\n",
        "    layers.Dense(4, activation='softmax')\n",
        "])\n",
        "\n",
        "model.compile(optimizer='adam', loss='sparse_categorical_crossentropy', metrics=['accuracy'])\n",
        "print(\"🧠 Training embedded baseline classifier model...\")\n",
        "history = model.fit(X_train, y_train, epochs=15, batch_size=32, validation_data=(X_val, y_val), verbose=0)\n",
        "val_acc = history.history['val_accuracy'][-1]\n",
        "print(f\"✅ Baseline training complete. Validation Accuracy: {val_acc*100:.2f}%\\n\")\n",
        "\n",
        "# --- 3. Run Post-Training INT8 Quantization Engine ---\n",
        "print(\"🛡️ Commencing Post-Training 8-Bit Quantization (INT8 Optimization)...\")\n",
        "\n",
        "def representative_data_gen():\n",
        "    # Feeds calibration dataset samples to properly map the dynamic scale factors\n",
        "    for input_value in tf.data.Dataset.from_tensor_slices(X_train).batch(1).take(100):\n",
        "        yield [input_value]\n",
        "\n",
        "converter = tf.lite.TFLiteConverter.from_keras_model(model)\n",
        "converter.optimizations = [tf.lite.Optimize.DEFAULT]\n",
        "converter.representative_dataset = representative_data_gen\n",
        "\n",
        "# Enforce integer weight calculations internally across convolutional layers\n",
        "converter.target_spec.supported_types = [tf.int8]\n",
        "\n",
        "tflite_model_quantized = converter.convert()\n",
        "\n",
        "# Calculate system storage metrics\n",
        "with open(\"bearing_fault_model.tflite\", \"wb\") as f:\n",
        "    f.write(tflite_model_quantized)\n",
        "\n",
        "quantized_size_kb = len(tflite_model_quantized) / 1024.0\n",
        "\n",
        "print(\"=\"*80)\n",
        "print(\"📟 TINYML MICROCONTROLLER STRUCTURAL TELEMETRY PROFILE\")\n",
        "print(\"=\"*80)\n",
        "print(f\"  • Post-Training Quantization Format : 8-Bit Integer (INT8 Weights/Activations)\")\n",
        "print(f\"  • Final Serialized Model Size        : {quantized_size_kb:.2f} KB\")\n",
        "print(f\"  • Deployment Footprint Validation    : {'COMPLIANT (<50 KB Target)' if quantized_size_kb < 50.0 else 'OVERSIZE VIOLATION'}\")\n",
        "print(\"=\"*80)\n",
        "\n",
        "# --- 4. Portfolio Resource Diagnostic Visualization ---\n",
        "plt.figure(figsize=(12, 5))\n",
        "\n",
        "# Plot 1: Ephemeral Vibrational Sensor Signals\n",
        "plt.subplot(1, 2, 1)\n",
        "plt.plot(X[y == 0][0].flatten(), label='Healthy Baseline', color='teal', alpha=0.8)\n",
        "plt.plot(X[y == 1][0].flatten(), label='Inner Race Fault', color='crimson', alpha=0.7)\n",
        "plt.plot(X[y == 2][0].flatten(), label='Outer Race Fault', color='chocolate', alpha=0.7)\n",
        "plt.title('Simulated Accel Vibrational Signatures')\n",
        "plt.xlabel('Time Windows (Discrete Index)')\n",
        "plt.ylabel('Acceleration Amplitude (g)')\n",
        "plt.grid(True, linestyle=':')\n",
        "plt.legend(loc='upper right', fontsize=9)\n",
        "\n",
        "# Plot 2: Storage Size Scaling Metric\n",
        "plt.subplot(1, 2, 2)\n",
        "unquantized_size_kb = (model.count_params() * 4 + 1024) / 1024.0 # Estimate Float32 binary size overhead\n",
        "\n",
        "# FIX: Removed the whitespace from 'darkslate gray' -> 'darkslategray'\n",
        "bars = plt.bar(['Standard Float32 Model', 'INT8 Quantized TinyML Model'], [unquantized_size_kb, quantized_size_kb],\n",
        "        color=['darkslategray', 'crimson'], edgecolor='black', alpha=0.85)\n",
        "plt.title('Memory Envelope Compression Bounds')\n",
        "plt.ylabel('Model Binary Footprint Size (KB)')\n",
        "plt.axhline(50.0, color='gray', linestyle='--', alpha=0.6, label='Microcontroller Flash Safe Margin (50 KB)')\n",
        "\n",
        "# Add text data values to bars\n",
        "for bar in bars:\n",
        "    yval = bar.get_height()\n",
        "    plt.text(bar.get_x() + bar.get_width()/2.0, yval + 1, f\"{yval:.2f} KB\", ha='center', va='bottom', fontweight='bold')\n",
        "\n",
        "plt.ylim(0, max(unquantized_size_kb, 55) * 1.1)\n",
        "plt.grid(axis='y', linestyle=':')\n",
        "plt.legend()\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig('tinyml_bearing_performance_report.png', dpi=300)\n",
        "plt.show()"
      ]
    }
  ]
}